class Solution:
    def convert(self, s: str, numRows: int) -> str:
        # numRowsが1の時、与えられたsが回答
        if numRows == 1:
            return s
        # numRowsの数値を使用しないので、_を使っている。回数繰り返しているだけ。　
        row_to_letters = [[] for _ in range(numRows)]
        # 行の位置。numRowsが3だったら、row_indexは0~2で動く
        row_index = 0
        # 進む方向。ジグザグの進む方向、numRowsが3で[P][A][Y]まで来たときに次のPを [P][A,P][Y]に入れるように折り返す。
        direction = 1
        # 入力sをletterで回す
        for letter in s:
            # 配列に追加
            row_to_letters[row_index].append(letter)
            # 次の行へ。directionが-1のときは折り返す
            row_index += direction
            # 0の時と、行の最後まで来たときにdirectionの符号を反転して折り返す
            if row_index == 0 or row_index == numRows -1:
                direction *= -1
        # "".joinはくぎりもじなしでの連結。"-".join()はP-A-A-Pのように連結
        return "".join(c for row in row_to_letters for c in row)
        
